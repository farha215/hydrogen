<root BTCPP_format="4" main_tree_to_execute="PreQualification_Task">

    <!-- Behavior Tree Definition (Integrated StayStill Version) -->
    <BehaviorTree ID="PreQualification_Task">
        <Sequence>
            <!-- 0. SYSTEMS CHECK -->
            <AllSystemsOK name="check_systems"/>

            <!-- 1. INITIALIZE (StayStill Integrated) -->
            <ActionInitialize name="initialize" 
                              target_depth="1.5"/>

            <!-- 2. GATE MISSION (StayStill Integrated) -->
            <ActionPassGate name="gate_mission" 
                            gate_depth="6.0" 
                            entry_pose="{T1}"/>

            <!-- 3. POLE MISSION (StayStill Integrated) -->
            <ActionOrbitPole name="pole_mission" 
                             radius="2.0"/>
            
            <!-- 4. RETURN HOME (StayStill Integrated) -->
            <ActionReturnHome name="return_mission" 
                              home_pose="{T1}" 
                              transit_duration="10.0" 
                              gate_depth="7.0"/>

        </Sequence>
    </BehaviorTree>

    <!-- Node Models for Groot -->
    <TreeNodesModel>
        <Condition ID="AllSystemsOK"/>
        <Action ID="ActionInitialize">
            <input_port name="target_depth" type="double">Depth to dive to</input_port>
        </Action>
        <Action ID="ActionPassGate">
            <input_port name="gate_depth" type="double">Distance to drive after gate</input_port>
            <output_port name="entry_pose" type="Pose">Saved pose for return</output_port>
        </Action>
        <Action ID="ActionOrbitPole">
            <input_port name="radius" type="double">Orbit radius in metres</input_port>
        </Action>
        <Action ID="ActionReturnHome">
            <input_port name="home_pose" type="Pose">The T1 pose to return to</input_port>
            <input_port name="transit_duration" type="double">Blind surge time</input_port>
            <input_port name="gate_depth" type="double">Final pass distance</input_port>
        </Action>
        <Action ID="StayStill">
            <input_port name="duration" type="double">Seconds to stay still</input_port>
        </Action>
    </TreeNodesModel>

</root>
